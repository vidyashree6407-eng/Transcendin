# ============================================================================
# ENROLLMENT SYSTEM ENVIRONMENT VARIABLES
# ============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file and rename to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to git
# 4. Keep this file secure (contains sensitive credentials)
#

# ============================================================================
# PAYPAL PAYMENT GATEWAY (REQUIRED)
# ============================================================================
# Get these from: https://developer.paypal.com/dashboard/
# DO NOT share these keys with anyone
# For testing, use sandbox credentials from PayPal dashboard

PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE
PAYPAL_ENV=sandbox


# ============================================================================
# EMAIL CONFIGURATION (REQUIRED for enrollment confirmations)
# ============================================================================
#
# Using Gmail:
# 1. Enable 2-Factor Authentication: https://myaccount.google.com/security
# 2. Generate app password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below (NOT your Gmail password)
#
# Using other providers (Outlook, SendGrid, etc):
# Adjust SMTP_HOST and SMTP_PORT accordingly
#

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
ENROLLMENT_FROM_EMAIL=noreply@transcendin.com


# ============================================================================
# CONTACT FORM EMAIL (REQUIRED)
# ============================================================================
# Email address where contact form submissions will be sent

CONTACT_TO=admin@transcendin.com
CONTACT_FROM=noreply@transcendin.com


# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

PORT=3000
NODE_ENV=development

# ORIGIN must match your client URL for CORS to work
# For local development: http://localhost:8000
# For production: https://yourdomain.com
ORIGIN=http://localhost:8000

# Admin dashboard credentials. Use a long random token secret in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password
ADMIN_TOKEN_SECRET=replace_with_a_long_random_secret


# ============================================================================
# OPTIONAL: DATABASE (for future upgrades)
# ============================================================================
# Currently using JSON files. Uncomment if migrating to database:

# DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/dbname
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# DATABASE_URL=mysql://user:pass@localhost:3306/dbname


# ============================================================================
# OPTIONAL: LOGGING & MONITORING
# ============================================================================
# Uncomment when setting up production monitoring:

# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# LOG_LEVEL=info
# DEBUG=false
